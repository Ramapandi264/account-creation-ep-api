		<snowflake:select doc:name="Select" doc:id="6ce6e7af-c714-4835-b3e2-430843e8fcd5" config-ref="Snowflake_Config">
			<snowflake:sql ><![CDATA[select * from ACCOUNT where ACCOUNT_NUMBER = :accountNumber and ACCOUNT_TYPE = :accountType]]></snowflake:sql>
			<snowflake:input-parameters ><![CDATA[#[{
	"accountNumber": vars.accountNumber,
	"accountType": vars.accountType
}]]]></snowflake:input-parameters>
		</snowflake:select>
		<choice doc:name="Choice" doc:id="dcb0d35d-749c-4e92-9c73-15b4c8032223" >
			<when expression='#[!isEmpty(payload) and payload.STATUS[0] == "Active"]'>
				<choice doc:name="Choice" doc:id="19f1272a-8472-462c-8e2b-90a7ec5d82ee" >
					<when expression="#[payload.PIN[0] == vars.pin]">
						<logger level="INFO" doc:name="Logger - PIN MATCHES" doc:id="81e6b463-fae8-41a7-86e0-4e5ab5e53800" message="pin is correct"/>
						<ee:transform doc:name="Transform Message - Check Balance" doc:id="2e858daf-a982-4e8b-a8a4-1078d53a4248">
							<ee:message>
								<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	"Account Balance ": payload.BALANCE[0]
}]]></ee:set-payload>
							</ee:message>
						</ee:transform>
					</when>
					<when expression="#[payload.PIN[0] != vars.pin]">
						<logger level="INFO" doc:name="Logger - PIN Not Matched" doc:id="831af77e-efea-4c0f-ba7e-24ab97a4b071" message="PIN not matched"/>
						<set-variable value="#[payload.WRONG_PIN_ATTEMPTS[0] + 1]" doc:name="Set Variable - Wrong Pin Attempts" doc:id="82fb43b6-cf40-4066-8cf7-b2d13ed2ea8f" variableName="wrongPinAttempts" />
						<choice doc:name="Choice" doc:id="c5325e72-7625-4aac-b220-c13e11dafa3b" >
							<when expression="#[vars.wrongPinAttempts &gt; 3]">
								<logger level="INFO" doc:name="Logger - Ma attempts failed" doc:id="3dd580ad-3103-4eb7-966e-8226baf0976b" message="Ma attempts failed "/>
								<snowflake:update doc:name="Update - Status " doc:id="8cafa685-b978-4c90-a62e-55a8ccbc29f9" config-ref="Snowflake_Config" >
									<snowflake:sql ><![CDATA[UPDATE ACCOUNT
SET WRONG_PIN_ATTEMPTS = :WRONG_PIN_ATTEMPTS,
    STATUS = :STATUS
WHERE ACCOUNT_NUMBER = :ACCOUNT_NUMBER
  AND ACCOUNT_TYPE = :ACCOUNT_TYPE]]></snowflake:sql>
									<snowflake:input-parameters ><![CDATA[#[{
	ACCOUNT_NUMBER: vars.accountNumber,
	ACCOUNT_TYPE: vars.accountType,
	WRONG_PIN_ATTEMPTS: vars.wrongPinAttempts,
	STATUS: "LoCKED"
	
}]]]></snowflake:input-parameters>
								</snowflake:update>
								<ee:transform doc:name="Transform Message" doc:id="3c6cd9c2-d53e-4dde-b6a1-b5b907038fb1" >
									<ee:message >
										<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"message": "Ma reries attempted, your account has been locked. Please reach out customer care and nearest service center"
}]]></ee:set-payload>
									</ee:message>
								</ee:transform>
							</when>
							<otherwise >
								<logger level="INFO" doc:name="Logger - wrong PIN" doc:id="460f78fd-9eee-4aad-b99a-e938ed86e9f6" message="Wrong PIN"/>
								<snowflake:update doc:name="Update - Wrong Pin Attempts" doc:id="2f2485cc-930f-42fb-9b04-95d6d975a27e" config-ref="Snowflake_Config">
									<snowflake:sql><![CDATA[UPDATE ACCOUNT
SET WRONG_PIN_ATTEMPTS = :WRONG_PIN_ATTEMPTS 
WHERE ACCOUNT_NUMBER = :ACCOUNT_NUMBER and ACCOUNT_TYPE = :ACCOUNT_TYPE]]></snowflake:sql>
									<snowflake:input-parameters><![CDATA[#[{
	ACCOUNT_NUMBER: vars.accountNumber,
	ACCOUNT_TYPE: vars.accountType,
	WRONG_PIN_ATTEMPTS: vars.wrongPinAttempts
	
}]]]></snowflake:input-parameters>
								</snowflake:update>
								<ee:transform doc:name="Transform Message" doc:id="cd76943b-29b4-474b-8d57-bb78dab08d85">
									<ee:message>
										<ee:set-payload><![CDATA[%dw 2.0
output application/json
var maxAttempts = 3
---
{
	"message": "Wrong ping ," ++ maxAttempts - vars.wrongPinAttempts ++ " left"
}]]></ee:set-payload>
									</ee:message>
								</ee:transform>
							</otherwise>
						</choice>
					</when>
					<otherwise >
						<logger level="INFO" doc:name="Logger" doc:id="8770acc1-b30c-4d73-a468-615c8c7fbd40" />
					</otherwise>
				</choice>
			</when>
			<when expression='#[!isEmpty(payload) and payload.STATUS[0] == "LoCKED"]'>
				<choice doc:name="Choice" doc:id="4c4a017a-76e0-4e34-8c76-15912ff953c0" >
					<when expression="#[payload.PIN[0] == vars.pin]">
						<snowflake:update doc:name="Update" doc:id="6349e2be-0370-44dc-9bce-9d008ac1b676" config-ref="Snowflake_Config" target="updateStatus">
							<snowflake:sql ><![CDATA[UPDATE ACCOUNT
SET STATUS = :STATUS
