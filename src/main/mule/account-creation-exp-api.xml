						</snowflake:update>
						<ee:transform doc:name="Transform Message" doc:id="fd0bf83f-51a0-4f8c-be7a-4c444e10046d" >
							<ee:message >
								<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"Account Balance ": payload.BALANCE[0]
}]]></ee:set-payload>
							</ee:message>
						</ee:transform>
					</when>
					<otherwise >
						<ee:transform doc:name="Transform Message" doc:id="2183f9b3-460c-421a-8138-735e1db43540">
					<ee:message>
						<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	"message": "account is In active"
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
					</otherwise>
				</choice>
			</when>
			<otherwise >
				<ee:transform doc:name="Transform Message" doc:id="01c1175d-0df3-472a-97df-af0a361cf0c6" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
