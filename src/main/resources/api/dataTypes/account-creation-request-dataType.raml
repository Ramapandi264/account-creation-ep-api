#%RAML 1.0 DataType
type: object
properties:
  firstName:
    type: string
    required: true
    minLength: 1

  lastName:
    required: true
    type: string
    minLength: 1
  mobileNumber:
    type: string
    pattern: ^[6-9][0-9]{9}$
    required: true
  email:
    type: string
    required: true

  aadhaarNumber:
    type: string
    required: true
    minLength: 1
  panNumber:
    type: string
    required: true
    minLength: 1
  accountType:
    type: string
    enum:
      - Savings
      - Current
      - Salaried
  initialDeposit:
    type: number
    minimum: 0
    maximum: 50000
  address:
    type: object
    properties:
      street:
      city:
      state:
      postalCode:
      country:
        

    
    
    


  