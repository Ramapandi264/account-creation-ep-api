#%RAML 1.0
title: account-creation-exp-api
version: 1.0
protocols:
  - HTTP
  - HTTPS

traits:
  account-creation: !include traits/account-creation-trait.raml

/createAccount:
  is:
    - account-creation
  post:
    body:
      application/json:
        type: !include dataTypes/account-creation-request-dataType.raml
        example: !include examples/account-creation-request.raml
    responses:
      201:
        body:
          application/json:
            
            example: !include examples/account-creation-response.raml

              
          